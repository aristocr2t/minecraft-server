#!/bin/bash -e

ENV=${ENV:-production}

for x in $(grep -v '^#' env/default.env | sed 's| |<$--space--$>|g' | xargs -0); do
  export "$(echo $x | sed 's|\<\$--space--\$\>| |g')"
done

if [ -f "env/$ENV.env" ]; then
  for x in $(grep -v '^#' env/$ENV.env | sed 's| |<$--space--$>|g' | xargs -0); do
    export "$(echo $x | sed 's|\<\$--space--\$\>| |g')"
  done
else
  echo "File env/$ENV.env not found, using env/default.env"
fi

bin="./mcrcon-$(uname -m)"
: "${RCON_PASSWORD:?RCON_PASSWORD is not set: add it to env/production.env}"

if [ $# -eq 0 ]; then
  docker exec -it "$SERVER_HOST" "$bin" -p "$RCON_PASSWORD"
else
  docker exec -i "$SERVER_HOST" "$bin" -p "$RCON_PASSWORD" "$@"
fi
