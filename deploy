#!/usr/bin/env bash

set -euo pipefail

# раскладывает наши конфиги из overlay/ поверх server/ и поднимает контейнер.
# идемпотентен: на работающем сервере ничего не рестартует, server.properties
# переписывается только если отличается от шаблона, пустой секрет не затирает старый.
# NO_START=1 — только разложить файлы, контейнер не трогать.

bash_ts() {
  echo $(date +'%Y-%m-%d %H:%M:%S')
}

export ENV=${ENV:-production}
export HOST=$(hostname)

for x in $(grep -v '^#' env/default.env | sed 's| |<$--space--$>|g' | xargs -0); do
  export "$(echo $x | sed 's|\<\$--space--\$\>| |g')"
done

if [ -f "env/$ENV.env" ]; then
  for x in $(grep -v '^#' env/$ENV.env | sed 's| |<$--space--$>|g' | xargs -0); do
    export "$(echo $x | sed 's|\<\$--space--\$\>| |g')"
  done
else
  echo "$(bash_ts) env/$ENV.env not found, using env/default.env"
fi

# файлы в server/ созданы контейнером от root — без sudo их не перезаписать
SUDO=""
if sudo -n true 2>/dev/null; then SUDO=sudo; fi

# worldgen-датапаки (Tectonic) должны лежать до создания мира
if [ -d datapacks ]; then
  $SUDO mkdir -p server/world/datapacks
  $SUDO cp -f datapacks/*.zip server/world/datapacks/
fi

# Mojang EULA: без файла сервер не стартует вообще
if [ ! -f server/eula.txt ]; then
  echo "eula=true" | $SUDO tee server/eula.txt >/dev/null
  echo "$(bash_ts) создал server/eula.txt (eula=true)"
fi

# --- overlay: наши конфиги (единственное место, где они версионируются) ---
if [ -d overlay/server ]; then
  echo "$(bash_ts) overlay → server/"
  $SUDO cp -R overlay/server/. server/
  $SUDO rm -f server/server.properties.tpl

  : "${RCON_PASSWORD:?RCON_PASSWORD не задан: создай env/$ENV.env по образцу env/production.env.example}"
  tmp=$(mktemp)
  # пустой MANAGEMENT_SERVER_SECRET оставляет строку как есть (не затираем секрет пустым)
  awk -v pw="$RCON_PASSWORD" -v ms="${MANAGEMENT_SERVER_SECRET:-}" '
    /^rcon\.password=/ { print "rcon.password=" pw; next }
    /^management-server-secret=/ { if (ms != "") print "management-server-secret=" ms; else print; next }
    { print }' overlay/server/server.properties.tpl >"$tmp"

  if [ -f server/server.properties ] && cmp -s "$tmp" server/server.properties; then
    echo "$(bash_ts) server.properties без изменений"
    rm -f "$tmp"
  else
    if [ -f server/server.properties ]; then
      $SUDO cp -p server/server.properties "server/server.properties.bak-$(date +%s)"
    fi
    $SUDO mv "$tmp" server/server.properties
    echo "$(bash_ts) server.properties из overlay/server/server.properties.tpl"
  fi
else
  echo "$(bash_ts) overlay/server не найден, конфиги не трогаю"
fi

if [ "${NO_START:-0}" = 1 ]; then
  echo "$(bash_ts) NO_START=1: файлы разложены, контейнер не трогаю"
  exit 0
fi

if [ ! "$(docker ps -aq -f name=^$SERVER_HOST$)" ]; then
  echo "$(bash_ts) install $SERVER_HOST:$SERVER_PORT"
  docker compose up --detach --build server
elif [ "$(docker ps -aq -f status=exited -f name=^$SERVER_HOST$)" ]; then
  echo "$(bash_ts) start $SERVER_HOST:$SERVER_PORT"
  docker start "$SERVER_HOST"
else
  echo "$(bash_ts) $SERVER_HOST уже работает, рестарт не нужен"
fi
