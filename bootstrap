#!/usr/bin/env bash

# развёртывание с нуля одной командой: Paper, плагины, кастомные плагины, конфиги, настройка.
# нужен только env/$ENV.env с RCON_PASSWORD. Идемпотентен.
# NO_START=1 — собрать и разложить файлы, но не запускать сервер и не делать ./setup.

set -euo pipefail
cd "$(dirname "$0")"

step() { echo; echo "== $*"; }

step "Paper 26.3"
./build-server

step "плагины из plugins.txt (Modrinth)"
./build-plugins

step "кастомные плагины (*/build.sh)"
./build-custom

step "конфиги из overlay/ и контейнер"
./deploy

if [ "${NO_START:-0}" = 1 ]; then
  echo "NO_START=1: ./setup пропущен (нужен живой сервер)"
  exit 0
fi

step "ждём rcon"
ready=0
for _ in $(seq 1 90); do
  if ./rcon "list" >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 2
done
if [ "$ready" = 0 ]; then
  echo "ошибка: rcon не поднялся за 3 минуты, смотри ./deploy и 'docker logs $SERVER_HOST'" >&2
  exit 1
fi

step "setup: группы прав, спавн, геймрулы"
./setup
