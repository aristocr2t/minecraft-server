#!/bin/bash -e

# downloads the newest Paper build for the given Minecraft version into server/server.jar
ver=${1:-26.3}

url=$(curl -s "https://fill.papermc.io/v3/projects/paper/versions/$ver/builds" |
  python3 -c 'import json, sys; print(json.load(sys.stdin)[0]["downloads"]["server:default"]["url"])')

echo "downloading $url"
curl -fL "$url" -o server/server.jar
